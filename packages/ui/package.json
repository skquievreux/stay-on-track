{
    "name": "@squievreux/ui",
    "version": "0.2.3",
    "description": "Quievreux Design System - Icons & UI Components",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./styles": "./dist/styles/tokens.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint src/",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "peerDependencies": {
        "lucide-react": ">=0.400.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@typescript-eslint/eslint-plugin": "^8.51.0",
        "@typescript-eslint/parser": "^8.51.0",
        "eslint": "^9.39.2",
        "globals": "^16.5.0",
        "lucide-react": "^0.460.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0",
        "typescript-eslint": "^8.51.0"
    },
    "keywords": [
        "quievreux",
        "design-system",
        "icons",
        "react",
        "tailwind"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quievreux/.github.git",
        "directory": "packages/ui"
    }
}
